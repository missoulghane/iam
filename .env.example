# Docker Compose environment — copy to `.env` and fill in real values.
#   cp .env.example .env
#
# This file is consumed by docker-compose.yml / .override.yml / .prod.yml.
# It only holds values that make sense in Docker (no native equivalent to
# stay in sync with): the "dev" Spring profile used by native runs needs
# none of them. Mail credentials are NOT here — they live in iam-api/.env
# instead, since that same value is also needed for native runs (see that
# file, and docker-compose.yml's backend.env_file list).

### PostgreSQL ###############################################################
POSTGRES_DB=iam
POSTGRES_USER=iam
# Change this before any real deployment.
POSTGRES_PASSWORD=iam
# Host port dev-only convenience mapping (docker-compose.override.yml).
POSTGRES_PORT=5432

### Spring Boot backend #######################################################
# "prod" reads datasource/JWT config from env vars below — used for both the
# local Docker dev stack and the VPS deploy (the app's "dev" Spring profile
# with its in-memory H2 database is only for running natively, outside Docker).
SPRING_PROFILES_ACTIVE=prod

# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-change-me-change-me-change-me-32bytes

# Mail credentials (MAIL_HOST/PORT/USERNAME/PASSWORD/FROM) are NOT here:
# they live in iam-api/.env, the single source used both natively and by
# Docker (see docker-compose.yml's backend.env_file list). Edit them there.

# Public URLs embedded in transactional emails — must point at the frontend
# origin your users actually browse to (localhost in dev, your domain in prod).
APP_VERIFICATION_BASE_URL=http://localhost:5173/verify-email
APP_ACCOUNT_ACTIVATION_BASE_URL=http://localhost:5173/activate-account
APP_PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password

# Host port dev-only convenience mapping (docker-compose.override.yml).
BACKEND_PORT=8080

### Frontend ###################################################################
# Prod-only public port (docker-compose.prod.yml). The dev port (5173) is
# fixed in docker-compose.override.yml and does not use this variable.
FRONTEND_PORT=80
