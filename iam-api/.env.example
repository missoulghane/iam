# Gmail SMTP credentials — use a Google App Password, not your account
# password (https://myaccount.google.com/apppasswords).
# Single source of truth: read here for native runs (mvnw spring-boot:run)
# AND by Docker Compose (docker-compose.yml loads this file in addition to
# .env for the backend service) — do not duplicate these values elsewhere.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@iam.ma
